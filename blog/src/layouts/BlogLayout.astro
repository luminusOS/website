---
import '../styles/global.css';
import GoogleFonts from '../../../src/components/shared/GoogleFonts.astro';
import SiteFooter from '../../../src/components/shared/SiteFooter.astro';
import SiteHeader from '../../../src/components/shared/SiteHeader.astro';
import SocialMeta from '../../../src/components/shared/SocialMeta.astro';
import ThemeInit from '../../../src/components/shared/ThemeInit.astro';
import { navEn } from '../../../src/i18n/nav';
import { buildSiteNav, mainRootOf } from '../../../src/lib/site-nav';
import { siteLinks, withBase } from '../lib/site';
import { translateLanguages, translateUrl } from '../lib/translate';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const { title, description, image = '/social-card.png', type = 'website', publishedTime } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const assetOrigin = import.meta.env.DEV ? Astro.url.origin : Astro.site;
const rssHref = withBase('/rss.xml');

const nav = buildSiteNav({ strings: navEn, sites: siteLinks, mainRoot: mainRootOf(siteLinks), current: 'blog' });

// Posts are written in English only, so the language slot offers a machine translation instead.
const language = {
  label: 'Translate',
  text: 'Translate',
  title: 'Translate',
  note: 'Posts are written in English. Read a machine translation via Google Translate:',
  items: translateLanguages.map((l) => ({
    href: translateUrl(Astro.site, Astro.url.pathname, l.code),
    name: l.label,
    rel: 'noopener nofollow',
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <ThemeInit />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="LuminusOS Blog" href={rssHref} />
    <SocialMeta
      title={title}
      description={description}
      url={canonical}
      image={new URL(withBase(image), assetOrigin)}
      siteName="LuminusOS Blog"
      type={type}
      publishedTime={publishedTime}
    />
    <GoogleFonts />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <SiteHeader nav={nav} logoSrc={withBase('/logos/brand.svg')} language={language} />

    <main>
      <slot />
    </main>

    <SiteFooter
      rights="LuminusOS Community"
      mainHref={siteLinks.main}
      links={[
        { href: rssHref, label: 'RSS' },
        { href: 'https://github.com/luminusOS/website', label: 'Source', external: true },
      ]}
    />
  </body>
</html>

<style is:global>
  main {
    min-height: 60vh;
  }
</style>
