---
import PostCard from '../../../src/components/shared/PostCard.astro';
import BlogHero from '../components/BlogHero.astro';
import PostFilters from '../components/PostFilters.astro';
import StatsStrip from '../components/StatsStrip.astro';
import BlogLayout from '../layouts/BlogLayout.astro';
import { postCardProps } from '../lib/post-card';
import { getPosts, imageCount } from '../lib/posts';
import { postDate } from '../lib/site';

const posts = await getPosts();
const [latest, ...older] = posts;

const countByTag = (list: typeof posts) =>
  [...list.reduce((map, post) => map.set(post.data.tag, (map.get(post.data.tag) ?? 0) + 1), new Map<string, number>())];
const allTags = countByTag(posts);

const stats = [
  { value: posts.length, label: 'Posts', note: 'release notes and stories' },
  { value: allTags.length, label: 'Projects', note: 'covered so far' },
  { value: posts.reduce((sum, post) => sum + imageCount(post), 0), label: 'Images', note: 'screenshots and recordings' },
  { value: postDate.format(latest.data.date), label: 'Latest', note: latest.data.tag, compact: true },
];
---

<BlogLayout
  title="LuminusOS Blog"
  description="Release announcements, development updates and stories from the LuminusOS project."
>
  <BlogHero latest={latest} />
  <StatsStrip stats={stats} />

  <section class="past">
    <div class="wide">
      <div class="head">
        <h2>Past posts</h2>
        <PostFilters tags={countByTag(older)} total={older.length} />
      </div>
      <ul class="grid" role="list" data-post-grid>
        {older.map((post) => <PostCard {...postCardProps(post)} />)}
      </ul>
    </div>
  </section>
</BlogLayout>

<style>
  .past {
    padding-block: clamp(3rem, 6vw, 4.5rem) clamp(3.5rem, 7vw, 5.5rem);
  }

  .wide {
    width: min(var(--container), calc(100% - 2.5rem));
    margin-inline: auto;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 1.75rem;
  }

  h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
