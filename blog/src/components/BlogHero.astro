---
import PostCard from '../../../src/components/shared/PostCard.astro';
import { postCardProps } from '../lib/post-card';
import type { Post } from '../lib/posts';
import { withBase } from '../lib/site';

interface Props {
  latest: Post;
}

const { latest } = Astro.props;
---

<section class="hero">
  <div class="inner">
    <div class="copy">
      <p class="eyebrow">News</p>
      <h1>What’s happening at LuminusOS?</h1>
      <p class="sub">
        Release notes, development updates and the occasional behind-the-scenes story from the
        people building Aurora Shell, Aetheris, ZapTide and the system around them.
      </p>
      <div class="ctas">
        <a class="btn btn-primary" href={withBase(`/posts/${latest.id}/`)}>Read the latest</a>
        <a class="btn btn-ghost" href={withBase('/rss.xml')}>Subscribe via RSS</a>
      </div>
    </div>
    <ul class="latest" role="list">
      <PostCard {...postCardProps(latest, true)} />
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem);
    background: radial-gradient(60rem 28rem at 90% -20%, var(--accent-wash), transparent 70%);
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    width: min(var(--container), calc(100% - 2.5rem));
    margin-inline: auto;
  }

  .copy {
    display: grid;
    gap: 1.3rem;
    justify-items: start;
  }

  h1 {
    max-width: 13ch;
    font-size: clamp(2.5rem, 5.6vw, 4.2rem);
    font-weight: 800;
  }

  .sub {
    max-width: 46ch;
    margin: 0;
    font-size: 1.1rem;
    color: var(--ink-dim);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .latest {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 900px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
