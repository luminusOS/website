---
import type { AppEntry } from '../data/apps';
import { translations, type Lang } from '../i18n';
import { setupHref } from '../lib/apps';
import { flatpak } from '../lib/flatpak';
import CommandBlock from './CommandBlock.astro';

interface Props {
  app: AppEntry;
  lang: Lang;
}

const { app, lang } = Astro.props;
const t = translations[lang];
const labels = t.setup.steps.map((step) => step.label);
const commands = flatpak.steps(app.id);
---

<section>
  <h2>{t.app.terminal}</h2>
  <p class="hint">
    {t.app.terminalHint} <a href={setupHref(lang)}>{t.setup.flatpakGuideLink}</a>
  </p>
  <div class="commands">
    {commands.map((command, index) => (
      <CommandBlock command={command} label={labels[index]} copy={t.app.copy} copied={t.app.copied} />
    ))}
  </div>
</section>

<style>
  h2 {
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .hint {
    margin: -0.4rem 0 1rem;
    font-size: 0.92rem;
    color: var(--ink-dim);
  }

  .hint a {
    color: var(--accent);
  }

  .commands {
    display: grid;
    gap: 0.75rem;
  }
</style>
