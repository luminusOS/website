---
import type { AppEntry } from '../data/apps';
import { translations, type Lang } from '../i18n';
import { setupHref, showcaseShot } from '../lib/apps';
import { withBase } from '../lib/site';

interface Props {
  lang: Lang;
  apps: AppEntry[];
}

const { lang, apps } = Astro.props;
const t = translations[lang].home;
// Two overlapping windows are enough to suggest a catalog.
const showcased = apps.slice(0, 2);
---

<section class="hero">
  <div class="container grid">
    <div class="copy">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.title}</h1>
      <p class="sub">{t.subtitle}</p>

      <form class="search" role="search">
        <label class="sr-only" for="app-search">{t.searchLabel}</label>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
        <input id="app-search" type="search" placeholder={t.searchPlaceholder} autocomplete="off" data-app-search />
      </form>

      <div class="ctas">
        <a class="btn btn-primary" href={setupHref(lang)}>{t.setup}</a>
        <a class="btn btn-ghost" href="#apps">{t.browse}</a>
      </div>
    </div>

    <div class="art" aria-hidden="true">
      <div class="glow"></div>
      {showcased.map((app, index) => (
        <img class:list={['shot', index === 0 ? 'back' : 'front']} src={withBase(showcaseShot(app))} alt="" width="640" height="420" />
      ))}
      {showcased.map((app, index) => (
        <img class:list={['icon', index === 0 ? 'icon-a' : 'icon-b']} src={withBase(app.icon)} alt="" width="84" height="84" />
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(2.5rem, 5vw, 4rem);
    background:
      radial-gradient(60rem 28rem at 85% -10%, var(--accent-wash), transparent 70%),
      var(--bg);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .copy {
    display: grid;
    gap: 1.35rem;
    justify-items: start;
  }

  h1 {
    max-width: 14ch;
    font-size: clamp(2.5rem, 5.6vw, 4.2rem);
    font-weight: 800;
  }

  .sub {
    max-width: 46ch;
    font-size: 1.12rem;
    color: var(--ink-dim);
  }

  .search {
    position: relative;
    display: flex;
    align-items: center;
    width: min(32rem, 100%);
    margin-top: 0.4rem;
  }

  .search svg {
    position: absolute;
    left: 1.1rem;
    color: var(--ink-faint);
    pointer-events: none;
  }

  .search input {
    width: 100%;
    padding: 0.95rem 1.2rem 0.95rem 3.1rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-pill);
    background: var(--surface-1);
    box-shadow: var(--shadow);
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
  }

  .search input::placeholder {
    color: var(--ink-faint);
  }

  .search input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .art {
    position: relative;
    aspect-ratio: 1.15;
    min-height: 18rem;
  }

  .glow {
    position: absolute;
    inset: 8% 4%;
    border-radius: 50%;
    background: conic-gradient(from 200deg, #33d17a55, #3584e455, #62a0ea33, #33d17a55);
    filter: blur(60px);
  }

  .shot {
    position: absolute;
    width: 78%;
    height: auto;
    border: 1px solid var(--border-color);
    border-radius: 14px;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.28);
    object-fit: cover;
  }

  .back {
    top: 2%;
    right: 0;
    transform: rotate(3deg);
  }

  .front {
    bottom: 4%;
    left: 0;
    transform: rotate(-3deg);
  }

  .icon {
    position: absolute;
    width: 5.25rem;
    height: 5.25rem;
    filter: drop-shadow(0 10px 18px rgb(0 0 0 / 0.3));
  }

  .icon-a {
    top: -2%;
    left: 8%;
  }

  .icon-b {
    right: 2%;
    bottom: -3%;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .art {
      max-width: 34rem;
    }
  }
</style>
