---
import type { Lang } from '../i18n/translations';
import { auroraHref, langPrefix, links, translations } from '../i18n/translations';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import CommunitySection from './home/CommunitySection.astro';
import DownloadSection from './home/DownloadSection.astro';
import HomeHero from './home/HomeHero.astro';
import HowSection from './home/HowSection.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
const aurora = auroraHref(langPrefix(lang));
---

<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description} path="/">
  <Header lang={lang} path="/" />

  <main>
    <HomeHero lang={lang} t={t} />

    <section class="band band--tint section" id="why">
      <div class="container">
        <div class="section-head">
          <h2>{t.pillars.title}</h2>
          <p>{t.pillars.subtitle}</p>
        </div>

        <div class="pillar-grid">
          {t.pillars.items.map((item) => (
            <article class="pillar">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="band band--plain section" id="about">
      <div class="container story-grid">
        <div class="story-year">
          <span>{t.story.since}</span>
          <strong>2020</strong>
        </div>

        <div class="story-copy">
          <p class="eyebrow">{t.story.eyebrow}</p>
          <h2>{t.story.title}</h2>
          <p>{t.story.body}</p>
        </div>
      </div>
    </section>

    <HowSection t={t} />
    <DownloadSection t={t} />

    <section class="band band--accent section">
      <div class="container teaser-grid">
        <div class="teaser-text">
          <p class="eyebrow">{t.aurora.eyebrow}</p>
          <h2>{t.aurora.title}</h2>
          <p>{t.aurora.subtitle}</p>
          <a class="btn btn-ghost" href={aurora}>{t.aurora.cta} →</a>
        </div>
        <div class="teaser-mark">
          <img src="/aurora-logo.svg" alt="Aurora Shell logo" width="180" height="180" loading="lazy" />
        </div>
      </div>
    </section>

    <CommunitySection t={t} />

    <section class="band band--plain section" id="support">
      <div class="container support-row">
        <div>
          <h2>{t.support.title}</h2>
          <p>{t.support.subtitle}</p>
        </div>
        <a class="btn btn-donate" href={links.donate} target="_blank" rel="noopener">
          {t.support.button}
          <svg class="support-heart" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 21s-7.5-4.35-9.5-8.72C.88 8.73 2.74 5 6.5 5A5.45 5.45 0 0 1 12 8.1 5.45 5.45 0 0 1 17.5 5c3.76 0 5.62 3.73 4 7.28C19.5 16.65 12 21 12 21Z" />
          </svg>
        </a>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 3.5rem) clamp(2.5rem, 6vw, 5rem);
  }

  .pillar {
    border-top: 2px solid var(--accent);
    padding-top: 1.1rem;
  }

  .pillar h3 {
    font-size: 1.3rem;
    margin-bottom: 0.55rem;
  }

  .pillar p {
    color: var(--ink-dim);
    font-size: 0.975rem;
  }

  .story-grid {
    display: grid;
    grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.5fr);
    gap: clamp(2.5rem, 8vw, 7rem);
    align-items: center;
  }

  .story-year {
    border-left: 3px solid var(--accent);
    display: grid;
    gap: 0.25rem;
    padding-left: clamp(1rem, 2.5vw, 1.75rem);
  }

  .story-year span {
    color: var(--ink-dim);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .story-year strong {
    color: var(--accent);
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    font-weight: 800;
    letter-spacing: -0.07em;
    line-height: 0.9;
  }

  .story-copy {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .story-copy h2 {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    max-width: 18ch;
  }

  .story-copy p:not(.eyebrow) {
    color: var(--ink-dim);
    font-size: 1.05rem;
    max-width: 62ch;
  }

  .teaser-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .teaser-text {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }

  .teaser-text h2 {
    font-size: clamp(2.2rem, 5vw, 3.25rem);
  }

  .teaser-text p:not(.eyebrow) {
    color: var(--ink-dim);
    max-width: 42ch;
  }

  .teaser-mark {
    background: #fff;
    border-radius: var(--radius-pill);
    padding: clamp(1.25rem, 3vw, 2rem);
    display: grid;
    place-items: center;
  }

  .support-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .support-row h2 {
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
  }

  .support-row p {
    margin-top: 0.8rem;
    color: var(--ink-dim);
    max-width: 52ch;
  }

  .support-heart {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    fill: #fff;
  }

  @media (max-width: 860px) {
    .teaser-grid {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }

  @media (max-width: 760px) {
    .pillar-grid,
    .story-grid,
    .support-row {
      grid-template-columns: 1fr;
    }

    .support-row {
      justify-items: start;
    }
  }
</style>
