---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import DeviceShowcase from './DeviceShowcase.astro';
import type { Lang } from '../i18n/translations';
import { translations, langPrefix, links, repos, auroraHref } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
const p = langPrefix(lang);
const aurora = auroraHref(p);

const roadmap = ['education', 'play', 'mobile', 'tablet', 'cast'] as const;

const editionIcons: Record<'workstation' | (typeof roadmap)[number], string> = {
  workstation: 'M3 5h18v11H3zM1 19h22v1.5H1z',
  education: 'M12 4L2 9l10 5 10-5zM6 11.5V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-4.5M22 9v5',
  play: 'M6 8h12a4 4 0 0 1 4 4v3a3 3 0 0 1-5.4 1.8L15 15H9l-1.6 1.8A3 3 0 0 1 2 15v-3a4 4 0 0 1 4-4z',
  mobile: 'M8 2h8a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm2 17h4',
  tablet: 'M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z',
  cast: 'M2 5h20v12h-8M2 21l5-.02A5 5 0 0 0 2 16zm0-4a9 9 0 0 1 9 9',
};

const workstation = t.editions.items.workstation;
---

<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description} path="/">
  <Header lang={lang} path="/" />

  <main>
    <section class="band band--plain hero">
      <div class="container">
        <div class="hero-top">
          <div>
            <p class="eyebrow">{t.hero.eyebrow}</p>
            <h1>{t.hero.title}<em>{t.hero.titleAccent}</em></h1>
            <p class="hero-sub">{t.hero.subtitle}</p>
            <div class="hero-ctas">
              <a class="btn btn-primary btn-lg" href={links.releasesLatest} target="_blank" rel="noopener">
                {t.hero.cta}
              </a>
              <a class="btn btn-ghost btn-lg" href={aurora}>{t.hero.ctaSecondary}</a>
            </div>
          </div>

          <dl class="hero-facts mono">
            {t.hero.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="hero-stage">
          <DeviceShowcase lang={lang} />
          <p class="device-note mono">{t.hero.deviceNote}</p>
        </div>
      </div>
    </section>

    <section class="band band--tint section" id="why">
      <div class="container">
        <div class="section-head">
          <h2>{t.pillars.title}</h2>
          <p>{t.pillars.subtitle}</p>
        </div>

        <div class="pillar-grid">
          {t.pillars.items.map((item) => (
            <article class="pillar">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="band band--plain section" id="how">
      <div class="container how-grid">
        <div>
          <div class="section-head">
            <h2>{t.how.title}</h2>
            <p>{t.how.subtitle}</p>
          </div>

          <ol class="steps">
            {t.how.steps.map((step) => (
              <li>
                <span class="step-num mono">{step.num}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <aside class="terminal" aria-label={t.how.terminalTitle}>
          <div class="terminal-bar">
            <i></i><i></i><i></i>
            <span class="mono">{t.how.terminalTitle}</span>
          </div>
          <pre class="mono"><code><span class="t-prompt">$</span> bootc status
<span class="t-ok">●</span> booted&#58;   ghcr.io/luminusos/luminusos-workstation&#58;44
  rollback&#58; 44.20260528

<span class="t-prompt">$</span> sudo bootc upgrade
<span class="t-dim">pulling image… layers cached</span>
<span class="t-dim">staging 44.20260610</span>
<span class="t-ok">✓</span> queued for next boot (rollback kept)</code></pre>
        </aside>
      </div>
    </section>

    <section class="band band--tint section" id="editions">
      <div class="container">
        <div class="section-head">
          <h2>{t.editions.title}</h2>
          <p>{t.editions.subtitle}</p>
        </div>

        <article class="card edition-featured">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="edition-icon" aria-hidden="true">
            <path d={editionIcons.workstation} stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <div class="edition-featured-body">
            <span class="chip chip--accent">{t.hero.available}</span>
            <h3>{workstation.name}</h3>
            <p class="edition-device mono">{workstation.device}</p>
            <p class="edition-body">{workstation.body}</p>
          </div>
          <a class="btn btn-primary" href={links.releasesLatest} target="_blank" rel="noopener">
            {t.editions.downloadLatest}
          </a>
        </article>

        <h3 class="roadmap-title">{t.editions.roadmapTitle}</h3>
        <ul class="roadmap" role="list">
          {roadmap.map((key) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="roadmap-icon" aria-hidden="true">
                <path d={editionIcons[key]} stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <b>{t.editions.items[key].name}</b>
              <span class="mono">{t.editions.items[key].device}</span>
            </li>
          ))}
        </ul>

        <p class="all-releases">
          <a href={links.releasesAll} target="_blank" rel="noopener">{t.editions.viewAll} ↗</a>
        </p>
      </div>
    </section>

    <section class="band band--accent section">
      <div class="container teaser-grid">
        <div class="teaser-text">
          <p class="eyebrow">{t.aurora.eyebrow}</p>
          <h2>{t.aurora.title}</h2>
          <p>{t.aurora.subtitle}</p>
          <a class="btn btn-ghost" href={aurora}>{t.aurora.cta} →</a>
        </div>
        <div class="teaser-mark">
          <img src="/aurora-logo.svg" alt="Aurora Shell logo" width="180" height="180" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="band band--plain section" id="download">
      <div class="container download-grid">
        <div class="download-copy">
          <h2>{t.download.title}</h2>
          <p>{t.download.subtitle}</p>
        </div>
        <div class="download-panel">
          <div class="download-split">
            <a class="btn btn-primary btn-lg" data-download data-repo={repos.images} href={links.sfFiles} target="_blank" rel="noopener">
              {t.download.button}
            </a>
            <details class="format-menu" data-format-menu>
              <summary aria-label={t.download.format} title={t.download.format}>
                <span class="mono" data-format-label>ISO</span>
                <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <ul role="list">
                <li><button type="button" class="mono" data-format="iso" aria-current="true">ISO</button></li>
                <li><button type="button" class="mono" data-format="qcow2">qcow2</button></li>
              </ul>
            </details>
          </div>
          <p class="download-version mono" data-release-tag hidden></p>
          <a class="download-notes" href={links.releasesLatest} target="_blank" rel="noopener">{t.download.notes} ↗</a>
          <p class="download-note">{t.download.note}</p>
        </div>
      </div>
    </section>

    <section class="band band--tint section" id="support">
      <div class="container support-row">
        <div>
          <h2>{t.support.title}</h2>
          <p>{t.support.subtitle}</p>
        </div>
        <a class="btn btn-donate" href={links.donate} target="_blank" rel="noopener">
          {t.support.button}
        </a>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<script>
  import { latestRelease } from '../scripts/latest-release';
  import { links } from '../i18n/translations';

  const button = document.querySelector<HTMLAnchorElement>('[data-download]')!;
  const tag = document.querySelector('[data-release-tag]')!;
  const menu = document.querySelector<HTMLDetailsElement>('[data-format-menu]')!;
  const label = menu.querySelector('[data-format-label]')!;
  const options = menu.querySelectorAll<HTMLButtonElement>('[data-format]');

  let version = '';
  let format = 'iso';

  const setHref = () => {
    if (version) {
      button.href = `${links.sfFiles}${version}/luminusos-workstation-${version}.${format}/download`;
    }
  };

  options.forEach((option) => {
    option.addEventListener('click', () => {
      format = option.dataset.format!;
      label.textContent = option.textContent;
      options.forEach((other) => other.setAttribute('aria-current', String(other === option)));
      menu.open = false;
      setHref();
    });
  });

  document.addEventListener('click', (e) => {
    if (e.target instanceof Node && !menu.contains(e.target)) menu.open = false;
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') menu.open = false;
  });

  latestRelease(button.dataset.repo!).then((release) => {
    if (!release) return;
    version = release.tag_name.replace(/^v/, '');
    tag.textContent = release.tag_name;
    tag.removeAttribute('hidden');
    setHref();
  });
</script>

<style>
  .hero {
    padding-block: clamp(3.5rem, 7vw, 6rem) clamp(3rem, 6vw, 5rem);
  }

  .hero-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: end;
  }

  .hero h1 {
    font-size: clamp(2.75rem, 6.4vw, 4.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    max-width: 13ch;
    margin-top: 1rem;
  }

  .hero h1 em {
    display: block;
    font-style: normal;
    color: var(--accent);
  }

  .hero-sub {
    max-width: 46ch;
    margin-top: 1.4rem;
    color: var(--ink-dim);
    font-size: clamp(1.05rem, 1.5vw, 1.175rem);
  }

  .hero-ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  /* The rail is what makes the hero read asymmetric. The device stage below
     stays full width because its 5 devices are positioned in percentages. */
  .hero-facts {
    margin: 0;
    display: grid;
    gap: 0.85rem;
    align-content: end;
    padding-inline-start: 1.75rem;
    border-inline-start: 1px solid var(--border-color);
  }

  .hero-facts dt {
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .hero-facts dd {
    margin: 0.15rem 0 0;
    font-size: 0.8rem;
    color: var(--ink-dim);
  }

  .hero-stage {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .device-note {
    margin-top: 1.75rem;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 3.5rem) clamp(2.5rem, 6vw, 5rem);
  }

  .pillar {
    border-top: 2px solid var(--accent);
    padding-top: 1.1rem;
  }

  .pillar h3 {
    font-size: 1.3rem;
    margin-bottom: 0.55rem;
  }

  .pillar p {
    color: var(--ink-dim);
    font-size: 0.975rem;
  }

  .how-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  .steps li {
    display: flex;
    gap: 1.3rem;
  }

  .step-num {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    margin-top: 0.1rem;
    border-radius: var(--radius-pill);
    background: var(--accent-wash);
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .steps h3 {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
  }

  .steps p {
    color: var(--ink-dim);
    font-size: 0.97rem;
  }

  /* A terminal is dark in both themes, so it uses its own token set. */
  .terminal {
    position: sticky;
    top: 5.5rem;
    color: #e8eefb;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--term-bg);
    overflow: hidden;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--term-line);
    background: var(--term-bar);
  }

  .terminal-bar i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--term-dim);
    opacity: 0.45;
  }

  .terminal-bar span {
    margin-left: auto;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--term-dim);
  }

  .terminal pre {
    margin: 0;
    padding: 1.2rem 1.3rem;
    font-size: 0.8rem;
    line-height: 1.75;
    overflow-x: auto;
  }

  .t-prompt { color: var(--aurora-green); }
  .t-ok { color: var(--accent-sky); }
  .t-dim { color: var(--term-dim); }

  .edition-featured {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    align-items: center;
    padding: clamp(1.75rem, 3vw, 2.5rem);
  }

  .edition-icon {
    width: 44px;
    height: 44px;
    color: var(--accent);
  }

  .edition-featured-body {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .edition-featured h3 {
    font-size: 1.6rem;
  }

  .edition-device {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
  }

  .edition-body {
    color: var(--ink-dim);
    font-size: 0.975rem;
    max-width: 46ch;
  }

  .roadmap-title {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* Hairline columns, not cards: the roadmap should read as planned, not disabled. */
  .roadmap {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .roadmap li {
    display: grid;
    gap: 0.45rem;
    justify-items: start;
    align-content: start;
    padding: 1.25rem 1.1rem;
    border-inline-start: 1px solid var(--border-color);
  }

  .roadmap li:first-child {
    border-inline-start: 0;
    padding-inline-start: 0;
  }

  .roadmap-icon {
    width: 24px;
    height: 24px;
    color: var(--ink-faint);
  }

  .roadmap b {
    font-size: 1rem;
    font-weight: 600;
  }

  .roadmap span {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .all-releases {
    margin-top: 2.2rem;
  }

  .all-releases a {
    color: var(--ink-dim);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .all-releases a:hover {
    color: var(--accent);
  }

  .teaser-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .teaser-text {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }

  .teaser-text h2 {
    font-size: clamp(2.2rem, 5vw, 3.25rem);
  }

  .teaser-text p:not(.eyebrow) {
    color: var(--ink-dim);
    max-width: 42ch;
  }

  /* The Aurora mark is multicolour, so it needs a light plate on the blue band. */
  .teaser-mark {
    background: #fff;
    border-radius: var(--radius-pill);
    padding: clamp(1.25rem, 3vw, 2rem);
    display: grid;
    place-items: center;
  }

  .download-grid {
    display: grid;
    grid-template-columns: 1fr minmax(19rem, 22rem);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .download-copy h2 {
    font-size: clamp(2.2rem, 4.5vw, 3rem);
  }

  .download-copy p {
    margin-top: 1rem;
    color: var(--ink-dim);
    max-width: 44ch;
  }

  .download-panel {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    padding: 1.75rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    background: var(--surface-2);
  }

  .download-split {
    justify-self: stretch;
    display: flex;
  }

  .download-split .btn {
    flex: 1;
    justify-content: center;
    border-start-end-radius: 0;
    border-end-end-radius: 0;
  }

  .format-menu {
    position: relative;
    display: flex;
  }

  .format-menu summary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding-inline: 0.9rem;
    list-style: none;
    cursor: pointer;
    user-select: none;
    background: var(--accent);
    color: var(--accent-ink);
    border-inline-start: 1px solid rgb(255 255 255 / 0.28);
    border-radius: var(--radius-pill);
    border-start-start-radius: 0;
    border-end-start-radius: 0;
    font-size: 0.85rem;
    font-weight: 600;
    transition: background 0.15s ease;
  }

  .format-menu summary::-webkit-details-marker {
    display: none;
  }

  .format-menu summary:hover,
  .format-menu[open] summary {
    background: var(--accent-hover);
  }

  .format-menu[open] summary svg {
    transform: rotate(180deg);
  }

  .format-menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    min-width: 8rem;
    display: grid;
    gap: 0.15rem;
    background: var(--surface-1);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06), 0 10px 28px rgb(0 0 0 / 0.14);
    z-index: 50;
  }

  .format-menu button {
    width: 100%;
    padding: 0.5rem 0.7rem;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink-dim);
    font-family: inherit;
    font-size: 0.9rem;
    text-align: start;
    cursor: pointer;
  }

  .format-menu button:hover {
    background: var(--surface-2);
    color: var(--ink);
  }

  .format-menu button[aria-current='true'] {
    color: var(--accent);
    font-weight: 600;
  }

  .download-version {
    margin-top: -0.35rem;
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .download-notes {
    color: var(--ink-dim);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .download-notes:hover {
    color: var(--accent);
  }

  .download-note {
    font-size: 0.82rem;
    color: var(--ink-faint);
  }

  .support-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .support-row h2 {
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
  }

  .support-row p {
    margin-top: 0.8rem;
    color: var(--ink-dim);
    max-width: 52ch;
  }

  @media (max-width: 860px) {
    .hero-top {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .hero-facts {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      gap: 1.25rem;
      padding: 1.25rem 0 0;
      border-inline-start: 0;
      border-top: 1px solid var(--border-color);
    }

    .how-grid {
      grid-template-columns: 1fr;
    }

    .terminal {
      position: static;
    }

    .edition-featured {
      grid-template-columns: auto 1fr;
    }

    .edition-featured > .btn {
      grid-column: 2;
      justify-self: start;
    }

    .teaser-grid {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .download-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .pillar-grid {
      grid-template-columns: 1fr;
    }

    .roadmap {
      grid-template-columns: 1fr 1fr;
    }

    .roadmap li {
      border-inline-start: 0;
      border-top: 1px solid var(--border-color);
      padding-inline: 0;
    }

    .support-row {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }

  @media (max-width: 560px) {
    .hero-facts {
      grid-auto-flow: row;
    }
  }
</style>
