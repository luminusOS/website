---
interface Props {
  rights: string;
  mainHref: string;
  links: { href: string; label: string; external?: boolean }[];
}

const { rights, mainHref, links } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-inner">
    <p>© {new Date().getFullYear()} {rights} · <a href={mainHref}>luminusos.org</a></p>
    <nav aria-label="Footer">
      {links.map((link) => (
        <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined}>
          {link.label}{link.external && <span aria-hidden="true"> ↗</span>}
        </a>
      ))}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 2rem;
    border-top: 1px solid var(--border-color);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    width: min(var(--container), calc(100% - 2.5rem));
    margin-inline: auto;
  }

  p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }

  a {
    color: var(--ink-dim);
    font-size: 0.85rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
  }
</style>
