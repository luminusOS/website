---
import type { Lang, Translation } from '../../i18n/translations';
import DeviceShowcase from '../DeviceShowcase.astro';

interface Props {
  lang: Lang;
  t: Translation;
}

const { lang, t } = Astro.props;
---

<section class="band band--plain hero">
  <div class="container">
    <div class="hero-top">
      <div>
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1>{t.hero.title}<em>{t.hero.titleAccent}</em></h1>
        <p class="hero-sub">{t.hero.subtitle}</p>
        <div class="hero-ctas">
          <a class="btn btn-primary btn-lg" href="#download">{t.hero.cta}</a>
          <a class="btn btn-community btn-lg" href="#community">
            <svg class="community-button-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
              <circle cx="9" cy="8" r="3" />
              <circle cx="17" cy="9" r="2.25" />
              <path d="M3.5 19c.35-3.45 2.2-5.25 5.5-5.25s5.15 1.8 5.5 5.25M14.25 14.5c.75-.5 1.65-.75 2.75-.75 2.35 0 3.7 1.35 4 4" />
            </svg>
            {t.hero.ctaCommunity}
            <span class="community-button-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <dl class="hero-facts mono">
        {t.hero.facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero-stage">
      <DeviceShowcase lang={lang} />
      <p class="device-note mono">{t.hero.deviceNote}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 7vw, 6rem) clamp(3rem, 6vw, 5rem);
  }

  .hero-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: end;
  }

  .hero h1 {
    font-size: clamp(2.75rem, 6.4vw, 4.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    max-width: 13ch;
    margin-top: 1rem;
  }

  .hero h1 em {
    display: block;
    font-style: normal;
    color: var(--accent);
  }

  .hero-sub {
    max-width: 46ch;
    margin-top: 1.4rem;
    color: var(--ink-dim);
    font-size: clamp(1.05rem, 1.5vw, 1.175rem);
  }

  .hero-ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .btn-community {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border-color));
    background: var(--accent-wash);
    color: var(--accent);
  }

  .btn-community:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .community-button-icon {
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .community-button-arrow {
    margin-inline-start: 0.15rem;
    transition: transform 0.15s ease;
  }

  .btn-community:hover .community-button-arrow {
    transform: translateX(2px);
  }

  .hero-facts {
    margin: 0;
    display: grid;
    gap: 0.85rem;
    align-content: end;
    padding-inline-start: 1.75rem;
    border-inline-start: 1px solid var(--border-color);
  }

  .hero-facts dt {
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .hero-facts dd {
    margin: 0.15rem 0 0;
    font-size: 0.8rem;
    color: var(--ink-dim);
  }

  .hero-stage {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .device-note {
    margin-top: 1.75rem;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }

  @media (max-width: 860px) {
    .hero-top {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .hero-facts {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      gap: 1.25rem;
      padding: 1.25rem 0 0;
      border-inline-start: 0;
      border-top: 1px solid var(--border-color);
    }
  }

  @media (max-width: 560px) {
    .hero-facts {
      grid-auto-flow: row;
    }
  }
</style>
