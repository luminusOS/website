---
import { siDiscord, siMastodon, siOpencollective, siReddit, siX } from 'simple-icons';
import type { Translation } from '../../i18n/translations';
import { links } from '../../i18n/translations';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
const communities = [
  { key: 'discord', href: links.discord, icon: siDiscord },
  { key: 'reddit', href: links.reddit, icon: siReddit },
  { key: 'mastodon', href: links.mastodon, icon: siMastodon },
  { key: 'x', href: links.x, icon: siX },
  { key: 'openCollective', href: links.donate, icon: siOpencollective },
] as const;
---

<section class="band band--tint section" id="community">
  <div class="container community-layout">
    <div class="section-head community-head">
      <h2>{t.community.title}</h2>
      <p>{t.community.subtitle}</p>
    </div>

    <div class="community-grid">
      {communities.map((community) => {
        const item = t.community.items[community.key];
        return (
          <a
            class="community-card"
            href={community.href}
            target="_blank"
            rel="noopener"
            style={'--brand: #' + community.icon.hex}
          >
            <span class="community-logo">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={community.icon.path} />
              </svg>
            </span>
            <span class="community-copy">
              <strong>{item.label}</strong>
            </span>
            <span class="community-arrow" aria-hidden="true">↗</span>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .community-head {
    grid-column: 2;
    grid-row: 1;
    max-width: 34rem;
    margin-bottom: 0;
  }

  .community-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .community-grid {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .community-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    min-height: 4.5rem;
    padding: 0.8rem 0.9rem;
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    background: var(--surface-1);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }

  .community-card:hover {
    border-color: color-mix(in srgb, var(--brand) 60%, var(--border-color));
    box-shadow: 0 8px 22px rgb(0 0 0 / 0.08);
    transform: translateY(-2px);
  }

  .community-card:last-child {
    grid-column: span 2;
  }

  .community-logo {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    flex-shrink: 0;
    place-items: center;
    border-radius: 0.7rem;
    background: var(--brand);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08);
    color: #fff;
  }

  .community-logo svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: currentColor;
  }

  .community-copy {
    display: grid;
    min-width: 0;
  }

  .community-copy strong {
    overflow: hidden;
    font-size: 0.92rem;
    letter-spacing: -0.005em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .community-arrow {
    margin-inline-start: auto;
    color: var(--ink-faint);
    font-size: 0.95rem;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .community-card:hover .community-arrow {
    color: var(--brand);
    transform: translate(2px, -2px);
  }

  @media (max-width: 860px) {
    .community-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .community-layout {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .community-head,
    .community-grid {
      grid-column: auto;
      grid-row: auto;
    }
  }

  @media (max-width: 560px) {
    .community-layout {
      gap: 1.5rem;
    }
  }

  @media (max-width: 420px) {
    .community-grid {
      grid-template-columns: 1fr;
    }

    .community-card:last-child {
      grid-column: auto;
    }
  }
</style>
