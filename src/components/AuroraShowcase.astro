---
interface ShowcaseItem {
  tag: string;
  title: string;
  body: string;
  video: string;
  alt: string;
}

interface Props {
  items: ShowcaseItem[];
  label: string;
}

const { items, label } = Astro.props;
const videoBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/video/aurora/aurora-`;
const dimensions: Record<string, readonly [number, number]> = {
  dock: [1280, 720],
  clipboard: [410, 550],
  mixer: [420, 440],
  calendar: [640, 360],
  tray: [512, 288],
};
const mediaWidth = (video: string) => dimensions[video][0];
const mediaHeight = (video: string) => dimensions[video][1];
---

<div class="tour" data-tour>
  <nav class="tour-list" aria-label={label}>
    {items.map((item) => (
      <a class="tour-tab" id={`tour-tab-${item.video}`} href={`#tour-panel-${item.video}`} data-video={item.video}>
        <span class="tour-thumbnail">
          <img src={`${videoBase}${item.video}.jpg`} alt="" width={mediaWidth(item.video)} height={mediaHeight(item.video)} loading="lazy" decoding="async" />
        </span>
        <span>{item.tag}</span>
      </a>
    ))}
  </nav>

  <div class="tour-stage">
    {items.map((item) => (
      <section class="tour-panel" id={`tour-panel-${item.video}`} aria-labelledby={`tour-title-${item.video}`}>
        <div class="tour-caption">
          <h3 id={`tour-title-${item.video}`}>{item.title}</h3>
          <p>{item.body}</p>
        </div>
        <video
          class="tour-video"
          muted
          playsinline
          controls
          preload="none"
          poster={`${videoBase}${item.video}.jpg`}
          aria-label={item.alt}
          width={mediaWidth(item.video)}
          height={mediaHeight(item.video)}
        >
          <source src={`${videoBase}${item.video}.webm`} type="video/webm" />
          <source src={`${videoBase}${item.video}.mp4`} type="video/mp4" />
        </video>
      </section>
    ))}
  </div>
</div>

<style>
  .tour {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .tour-list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(8rem, 1fr);
    gap: 0.5rem;
    overflow-x: auto;
    padding: 0.25rem;
  }

  .tour-stage {
    display: grid;
    gap: 1rem;
  }

  .tour-tab {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    padding: 0.375rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    background: var(--surface-1);
    color: var(--ink);
    text-decoration: none;
    font-size: 0.875rem;
    text-align: center;
    line-height: 1.35;
  }

  .tour-thumbnail {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }

  .tour-thumbnail img {
    position: absolute;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tour-tab[data-video='dock'] img { object-position: bottom; }
  .tour-tab[data-video='clipboard'] img,
  .tour-tab[data-video='mixer'] img,
  .tour-tab[data-video='calendar'] img,
  .tour-tab[data-video='tray'] img { object-position: top; }

  .tour-tab:hover {
    background: var(--surface-2);
  }

  .tour-tab[aria-selected='true'] {
    border-color: var(--accent);
    background: var(--accent-wash);
    box-shadow: inset 0 -3px var(--accent);
  }

  .tour-tab[aria-selected='true'] > span:last-child {
    font-weight: 700;
  }

  .tour-tab:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .tour-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.75fr);
    grid-template-areas: "caption media";
    align-items: center;
    min-width: 0;
    scroll-margin-top: 6rem;
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
  }

  .tour-panel[hidden] {
    display: none;
  }

  .tour-caption {
    grid-area: caption;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .tour-caption h3 {
    font-size: clamp(1.35rem, 2.5vw, 2rem);
  }

  .tour-caption p {
    max-width: 65ch;
    margin: 0.35rem 0 0;
    color: var(--ink-dim);
    font-size: 0.95rem;
  }

  .tour-video {
    grid-area: media;
    display: block;
    width: 100%;
    height: auto;
    max-height: 32rem;
    object-fit: contain;
    background: #0d1020;
  }

  @media (max-width: 760px) {
    .tour-panel {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "caption" "media";
    }

    .tour-list {
      grid-auto-columns: clamp(7rem, 32vw, 9rem);
      scroll-snap-type: x proximity;
    }

    .tour-tab {
      scroll-snap-align: start;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-tour]');
  if (root) {
    const list = root.querySelector('nav')!;
    const tabs = [...list.querySelectorAll<HTMLAnchorElement>('[data-video]')];
    const panels = [...root.querySelectorAll<HTMLElement>('.tour-panel')];
    const videos = panels.map((panel) => panel.querySelector('video')!);

    function select(index: number) {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[i].hidden = !active;
        if (!active) videos[i].pause();
      });
    }

    list.setAttribute('role', 'tablist');

    tabs.forEach((tab, index) => {
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', panels[index].id);
      panels[index].setAttribute('role', 'tabpanel');
      panels[index].setAttribute('aria-labelledby', tab.id);

      tab.addEventListener('click', (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        select(index);
      });

      tab.addEventListener('keydown', (event) => {
        let target: number;
        if (event.key === 'ArrowRight') target = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') target = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') target = 0;
        else if (event.key === 'End') target = tabs.length - 1;
        else if (event.key === ' ') target = index;
        else return;
        event.preventDefault();
        select(target);
        tabs[target].focus();
      });
    });

    function selectFromHash() {
      const index = panels.findIndex((panel) => `#${panel.id}` === location.hash);
      if (index >= 0) select(index);
      return index;
    }

    if (selectFromHash() < 0) select(0);
    window.addEventListener('hashchange', selectFromHash);

    document.querySelectorAll<HTMLAnchorElement>('[data-tour-open]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        const index = tabs.findIndex((tab) => tab.dataset.video === link.dataset.tourOpen);
        if (index >= 0) select(index);
      });
    });
  }
</script>
