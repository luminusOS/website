---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import AuroraShowcase from './AuroraShowcase.astro';
import type { Lang } from '../i18n/translations';
import '../styles/product-page.css';
import { translations, langPrefix, links, mainSite, repos } from '../i18n/translations';

interface Props {
  lang: Lang;
  path?: string;
}

const { lang, path = '/aurora' } = Astro.props;
const t = translations[lang];
const page = t.auroraPage;
const p = langPrefix(lang);
const homeHref = `${mainSite}${p}` || '/';

const fallbackVersion = 'v51.1';

---

<BaseLayout lang={lang} title={page.meta.title} description={page.meta.description} path={path}>
  <Header lang={lang} path={path} />

  <main class="product-page product-page--aurora">
    <section class="band band--plain product-hero">
      <div class="container product-hero-inner">
        <img
          class="product-logo"
          src="/aurora-logo.svg"
          alt="Aurora Shell logo"
          width="128"
          height="128"
        />
        <div class="product-hero-copy">
          <p class="eyebrow">{page.eyebrow}</p>
          <h1>{page.title}</h1>
          <p class="product-hero-sub">{page.subtitle}</p>
          <div class="product-hero-ctas">
            <a class="btn btn-primary" href={links.auroraEgo} target="_blank" rel="noopener">
              {page.install}
            </a>
            <a class="btn btn-ghost" href={links.auroraRepo} target="_blank" rel="noopener">
              {page.source} ↗
            </a>
          </div>
          <p class="product-version mono">
            {page.version}: <a href={`${links.auroraRepo}/releases/latest`} target="_blank" rel="noopener"><strong data-aurora-version data-repo={repos.aurora}>{fallbackVersion}</strong></a> · GNOME Shell 51 · GPL-3.0
          </p>
        </div>
      </div>
    </section>

    <section class="band band--tint section">
      <div class="container product-quote">
        <h2>{page.philosophyTitle}</h2>
        <blockquote>“{page.philosophy}”</blockquote>
      </div>
    </section>

    <section class="band band--plain section" id="spotlight">
      <div class="container">
        <div class="section-head">
          <h2>{page.spotlightTitle}</h2>
          <p>{page.spotlightSubtitle}</p>
        </div>

        <AuroraShowcase
          items={page.spotlights}
          label={page.spotlightTitle}
          playLabel={page.spotlightPlay}
          pauseLabel={page.spotlightPause}
        />
      </div>
    </section>

    <section class="band band--tint section" id="modules">
      <div class="container">
        <div class="section-head">
          <h2>{page.modulesTitle}</h2>
          <p>{page.modulesSubtitle}</p>
        </div>

        <div class="module-groups">
          {page.moduleGroups.map((group, groupIndex) => (
            <section class="module-group" aria-labelledby={`module-group-${groupIndex}`}>
              <header class="module-group-head">
                <h3 class="module-group-title" id={`module-group-${groupIndex}`}>{group.name}</h3>
                <span class="module-group-count">{group.modules.length}</span>
              </header>
              <ul class="module-list">
                {group.modules.map((module) => (
                  <li class="module-item">
                    <h4>{module.name}</h4>
                    <p>{module.body}</p>
                    {module.demo && (
                      <a class="module-demo" href="#spotlight" data-tour-open={module.demo} aria-label={`${page.watchDemo}: ${module.name}`}>
                        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" fill="currentColor"><path d="M4.5 2.8v10.4L13 8z" /></svg>
                        {page.watchDemo}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="band band--accent section">
      <div class="container">
        <div class="section-head">
          <h2>{page.designTitle}</h2>
        </div>
        <div class="design-grid">
          {page.design.map((principle) => (
            <article class="design-item">
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </article>
          ))}
        </div>

        <p class="back-home">
          <a href={homeHref}>← {page.backHome}</a>
        </p>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<script>
  import { latestRelease } from '../scripts/latest-release';

  const version = document.querySelector<HTMLElement>('[data-aurora-version]')!;
  latestRelease(version.dataset.repo!).then((release) => {
    if (release) version.textContent = release.tag_name;
  });
</script>
