---
import type { Lang } from '../i18n/translations';
import { buildSiteNav } from '../lib/site-nav';
import { translations, langPrefix, languages, mainSite, siblingLinks, siteVariant } from '../i18n/translations';
import SiteHeader from './shared/SiteHeader.astro';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const prefix = langPrefix(lang);
const current = languages.find((l) => l.code === lang)!;
const t = translations[lang];

const sectionOf = (route: string) => {
  if (siteVariant === 'aurora' || route.startsWith('/aurora')) return 'aurora';
  if (route === '/') return 'home';
  if (route.startsWith('/contribute')) return 'contribute';
  return 'main';
};

const nav = buildSiteNav({
  strings: t.nav,
  sites: siblingLinks(prefix),
  mainRoot: `${mainSite}${prefix}/`,
  current: sectionOf(path),
});

const language = {
  label: current.name,
  text: lang === 'pt-br' ? 'PT' : 'EN',
  flag: current.flag,
  title: t.nav.language,
  items: languages.map((l) => ({
    href: (langPrefix(l.code) + path) || '/',
    name: l.name,
    flag: l.flag,
    current: l.code === lang,
  })),
};
---

<SiteHeader nav={nav} logoSrc="/logos/brand.svg" language={language} />
