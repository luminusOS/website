---
import type { Lang } from '../i18n/translations';
import { translations, langPrefix, languages, links, mainSite, siteVariant, auroraHref, siteHref } from '../i18n/translations';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = translations[lang];
const p = langPrefix(lang);
const current = languages.find((l) => l.code === lang)!;

const link = {
  overview: { href: `${mainSite}${p}/#why`, label: t.nav.overview },
  how: { href: `${mainSite}${p}/#how`, label: t.nav.how },
  editions: { href: `${mainSite}${p}/#download`, label: t.nav.editions },
  aurora: { href: auroraHref(p), label: t.nav.auroraShort },
  aetheris: { href: `${mainSite}${p}/aetheris`, label: t.nav.aetheris },
  wiki: { href: siteHref('/wiki', links.wikiSite), label: t.nav.wiki },
  blog: { href: siteHref('/blog', links.blogSite), label: t.nav.blog },
};

// The bar keeps Aurora flat while the panel files it under Products, so both
// arrangements are written out rather than sliced out of one another.
const desktopNav = [link.overview, link.how, link.editions, link.aurora];
const desktopProducts = [link.aetheris];
const desktopResources = [link.wiki, link.blog];

const mobileGroups = [
  { label: null, items: [link.overview, link.how, link.editions] },
  { label: t.nav.products, items: [link.aurora, link.aetheris] },
  { label: t.nav.resources, items: [link.wiki, link.blog] },
];

const chevronPath = 'm6 9 6 6 6-6';
const heartPath =
  'M12 21s-7.5-4.7-10-9.3C.4 8.6 2.4 5 5.8 5c2 0 3.4 1.1 4.2 2.4l2 .1 2-.1C14.8 6.1 16.2 5 18.2 5c3.4 0 5.4 3.6 3.8 6.7C19.5 16.3 12 21 12 21z';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={siteVariant ? `${mainSite}${p}` : p || '/'}>
      <img src="/logos/brand.svg" alt="" width="28" height="28" />
      <span>Luminus<strong>OS</strong></span>
    </a>

    <nav class="main-nav" aria-label="Main">
      {desktopNav.map((item) => <a href={item.href}>{item.label}</a>)}
      <details class="nav-menu" data-nav-menu>
        <summary>
          {t.nav.products}
          <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d={chevronPath} />
          </svg>
        </summary>
        <ul role="list">
          {desktopProducts.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </details>
      {desktopResources.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label={t.nav.themeToggle} title={t.nav.themeToggle}>
        <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" />
          <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M19.4 4.6l-1.8 1.8M6.4 17.6l-1.8 1.8" />
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>

      <details class="lang-menu" data-lang-menu>
        <summary class="mono" aria-label={current.name}>
          <span class="flag" aria-hidden="true">{current.flag}</span>
          {lang === 'pt-br' ? 'PT' : 'EN'}
          <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d={chevronPath} />
          </svg>
        </summary>
        <ul role="list">
          {languages.map((l) => (
            <li>
              <a
                href={(langPrefix(l.code) + path) || '/'}
                aria-current={l.code === lang ? 'true' : undefined}
              >
                <span class="flag" aria-hidden="true">{l.flag}</span>
                {l.name}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <details class="mobile-menu" data-mobile-menu>
        <summary aria-label={t.nav.menu}>
          <svg class="icon-burger" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg class="icon-close" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </summary>
        <div class="mobile-panel">
          {mobileGroups.map((group) => (
            <nav class="mobile-group" aria-label={group.label ?? t.nav.menu}>
              {group.label && <p class="mobile-group-title mono">{group.label}</p>}
              {group.items.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))}
            </nav>
          ))}

          <div class="mobile-group">
            <p class="mobile-group-title mono">{t.nav.language}</p>
            <div class="mobile-langs">
              {languages.map((l) => (
                <a
                  href={(langPrefix(l.code) + path) || '/'}
                  aria-current={l.code === lang ? 'true' : undefined}
                >
                  <span class="flag" aria-hidden="true">{l.flag}</span>
                  {l.name}
                </a>
              ))}
            </div>
          </div>

          <div class="mobile-actions">
            <a class="btn btn-primary" href={`${mainSite}${p}/#download`}>{t.nav.download}</a>
            <a class="btn btn-donate" href={links.donate} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
                <path d={heartPath} />
              </svg>
              {t.nav.donate}
            </a>
          </div>
        </div>
      </details>

      <a class="donate-icon" href={links.donate} target="_blank" rel="noopener" aria-label={t.nav.donate} title={t.nav.donate}>
        <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
          <path d={heartPath} />
        </svg>
      </a>
      <a class="btn btn-primary btn-sm" href={`${mainSite}${p}/#download`}>{t.nav.download}</a>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
    });
  });

  const openMenus = () =>
    document.querySelectorAll('[data-lang-menu][open], [data-nav-menu][open], [data-mobile-menu][open]');

  document.addEventListener('click', (e) => {
    openMenus().forEach((menu) => {
      if (e.target instanceof Node && !menu.contains(e.target)) {
        menu.removeAttribute('open');
      }
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') openMenus().forEach((menu) => menu.removeAttribute('open'));
  });

  document.querySelectorAll('[data-mobile-menu] a').forEach((link) => {
    link.addEventListener('click', () => {
      link.closest('[data-mobile-menu]')?.removeAttribute('open');
    });
  });

  const mobileMenu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  mobileMenu?.addEventListener('toggle', () => {
    document.body.classList.toggle('has-open-menu', mobileMenu.open);
  });

  // The header shares the page background, so the hairline only appears once
  // the content has scrolled under it.
  const header = document.querySelector('.site-header')!;
  const updateHairline = () => header.classList.toggle('is-scrolled', window.scrollY > 4);
  updateHairline();
  window.addEventListener('scroll', updateHairline, { passive: true });
</script>

<style>
  .site-header {
    --header-h: 3.75rem;
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--header-bg);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--border-color);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: var(--header-h);
    padding-block: 0.55rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    padding: 0.35rem 0.5rem 0.35rem 0.35rem;
    margin-left: -0.35rem;
    border-radius: var(--radius-sm);
    transition: background 0.12s ease;
  }

  .brand:hover {
    background: var(--surface-2);
  }

  .brand strong {
    color: var(--accent);
    font-weight: 700;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .main-nav a,
  .nav-menu summary {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.45rem 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-size: 0.925rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    transition: background 0.12s ease;
  }

  .main-nav a:hover,
  .nav-menu summary:hover,
  .nav-menu[open] summary {
    background: var(--surface-2);
    color: var(--ink);
  }

  .nav-menu {
    position: relative;
    display: inline-flex;
  }

  .nav-menu summary {
    list-style: none;
  }

  .nav-menu summary::-webkit-details-marker {
    display: none;
  }

  .nav-menu[open] summary svg {
    transform: rotate(180deg);
  }

  .nav-menu ul {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: calc(100% + 0.5rem);
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    min-width: 11rem;
    display: grid;
    gap: 0.15rem;
    background: var(--surface-1);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06), 0 10px 28px rgb(0 0 0 / 0.14);
    z-index: 50;
  }

  .nav-menu ul a {
    display: block;
    padding: 0.5rem 0.7rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--ink-dim);
  }

  .nav-menu ul a:hover {
    background: var(--surface-2);
    color: var(--ink);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .header-actions::before {
    content: '';
    width: 1px;
    height: 1.35rem;
    background: var(--border-color);
    margin-inline: 0.5rem 0.25rem;
  }

  .theme-toggle {
    width: 2.25rem;
  }

  .donate-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    min-height: 2.25rem;
    border-radius: var(--radius-sm);
    color: var(--destructive);
    transition: background 0.12s ease, color 0.12s ease;
  }

  .donate-icon:hover {
    background: var(--surface-2);
    color: var(--destructive-hover);
  }

  .theme-toggle .icon-sun { display: none; }
  :global(html[data-theme='dark']) .theme-toggle .icon-sun { display: block; }
  :global(html[data-theme='dark']) .theme-toggle .icon-moon { display: none; }

  .lang-menu {
    position: relative;
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  .theme-toggle,
  .lang-menu summary,
  .mobile-menu summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 2.25rem;
    border: none;
    background: transparent;
    border-radius: var(--radius-sm);
    color: var(--ink-dim);
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: background 0.12s ease, color 0.12s ease;
  }

  .mobile-menu summary {
    width: 2.25rem;
  }

  .lang-menu summary {
    padding-inline: 0.6rem;
    font-size: 0.8rem;
  }

  .theme-toggle:hover,
  .lang-menu summary:hover,
  .mobile-menu summary:hover,
  .lang-menu[open] summary,
  .mobile-menu[open] summary {
    background: var(--surface-2);
    color: var(--ink);
  }

  .lang-menu summary::-webkit-details-marker,
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu .icon-close { display: none; }
  .mobile-menu[open] .icon-burger { display: none; }
  .mobile-menu[open] .icon-close { display: block; }

  /* Starts below the bar: covering it would hide the close button and fight
     the sticky header's stacking context. */
  .mobile-panel {
    position: fixed;
    inset: var(--header-h) 0 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: 1.75rem 1.25rem calc(1.25rem + env(safe-area-inset-bottom));
    background: var(--bg);
    overflow-y: auto;
    overscroll-behavior: contain;
    animation: mobile-panel-in 0.18s ease-out;
  }

  @keyframes mobile-panel-in {
    from { opacity: 0; transform: translateY(-0.5rem); }
    to { opacity: 1; transform: none; }
  }

  .mobile-group {
    display: grid;
    gap: 0.15rem;
    width: min(34rem, 100%);
    margin-inline: auto;
  }

  .mobile-group-title {
    margin: 0 0 0.4rem;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* Scoped to the groups so the action buttons keep their pill shape. */
  .mobile-group a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 3.25rem;
    padding: 0.6rem 0.85rem;
    margin-inline: -0.85rem;
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    font-size: 1.15rem;
    font-weight: 500;
  }

  .mobile-group a:hover,
  .mobile-group a:active {
    background: var(--surface-2);
  }

  /* The language pair never needs full rows. */
  .mobile-langs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .mobile-langs a {
    justify-content: center;
    gap: 0.45rem;
    margin-inline: 0;
    font-size: 1rem;
    border: 1px solid var(--border-color);
  }

  .mobile-langs a[aria-current='true'] {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-wash);
  }

  .mobile-actions {
    display: grid;
    gap: 0.6rem;
    width: min(34rem, 100%);
    margin-inline: auto;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .mobile-actions .btn {
    justify-content: center;
    min-height: 3.25rem;
    font-size: 1.05rem;
  }

  .mobile-actions .btn-primary {
    color: var(--accent-ink);
  }

  .mobile-actions .btn-donate {
    color: #fff;
  }

  .lang-menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    min-width: 11rem;
    display: grid;
    gap: 0.15rem;
    background: var(--surface-1);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06), 0 10px 28px rgb(0 0 0 / 0.14);
    z-index: 50;
  }

  .lang-menu ul a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--ink-dim);
  }

  .lang-menu ul a:hover {
    background: var(--surface-2);
    color: var(--ink);
  }

  .lang-menu ul a[aria-current='true'] {
    color: var(--accent);
    font-weight: 600;
  }

  .flag {
    font-size: 1rem;
    line-height: 1;
  }

  /* Once the hamburger appears, language and donate live in the panel so the
     bar keeps a single primary action instead of five competing controls. */
  @media (max-width: 980px) {
    .main-nav,
    .lang-menu,
    .donate-icon {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    :global(body.has-open-menu) {
      overflow: hidden;
    }

    .theme-toggle,
    .mobile-menu summary {
      width: 2.5rem;
      min-height: 2.5rem;
    }

    /* The separator divides nav from actions; with the nav gone it is noise. */
    .header-actions::before {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .header-actions > .btn-primary {
      padding-inline: 1rem;
    }
  }

  @media (max-width: 420px) {
    .header-inner {
      gap: 0.8rem;
    }

    .brand span {
      font-size: 1rem;
    }

    .header-actions {
      gap: 0.15rem;
    }
  }
</style>
