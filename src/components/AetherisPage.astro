---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import type { Lang } from '../i18n/translations';
import '../styles/product-page.css';
import { translations, langPrefix, links, mainSite, repos } from '../i18n/translations';

interface Props {
  lang: Lang;
  path?: string;
}

const { lang, path = '/aetheris' } = Astro.props;
const t = translations[lang];
const page = t.aetherisPage;
const p = langPrefix(lang);
const homeHref = `${mainSite}${p}` || '/';

const fallbackVersion = 'v1.2.0';
---

<BaseLayout lang={lang} title={page.meta.title} description={page.meta.description} path={path}>
  <Header lang={lang} path={path} />

  <main class="product-page product-page--aetheris">
    <section class="band band--plain product-hero">
      <div class="container product-hero-inner">
        <img
          class="product-logo"
          src="/aetheris-logo.svg"
          alt="Aetheris logo"
          width="128"
          height="128"
        />
        <div class="product-hero-copy">
          <p class="eyebrow">{page.eyebrow}</p>
          <h1>{page.title}</h1>
          <p class="product-hero-sub">{page.subtitle}</p>
          <div class="product-hero-ctas">
            <a
              class="btn btn-primary"
              href={links.aetherisReleases}
              target="_blank"
              rel="noopener"
              data-aetheris-download
              data-repo={repos.aetheris}
              data-download-linux={page.downloadLinux}
              data-download-mac={page.downloadMac}
              data-download-windows={page.downloadWindows}
            >
              {page.downloadGeneric}
            </a>
            <a class="btn btn-ghost" href={links.aetherisReleases} target="_blank" rel="noopener">
              {page.allDownloads} ↗
            </a>
          </div>
          <p class="product-version mono">
            {page.status}: <strong data-aetheris-version>{fallbackVersion}</strong> · Linux · Windows · macOS
          </p>
        </div>
      </div>
    </section>

    <section class="band band--tint section">
      <div class="container product-quote">
        <h2>{page.meaningTitle}</h2>
        <blockquote>“{page.meaning}”</blockquote>
      </div>
    </section>

    <section class="band band--plain section" id="screenshots">
      <div class="container">
        <div class="section-head">
          <h2>{page.screenshotsTitle}</h2>
          <p>{page.screenshotsSubtitle}</p>
        </div>

        <div class="showcase-list">
          {page.screenshots.map((screenshot) => (
            <article class="showcase">
              <div class="showcase-text">
                <span class="chip">{screenshot.tag}</span>
                <h3>{screenshot.title}</h3>
                <p>{screenshot.body}</p>
              </div>
              <div class="showcase-media">
                <img src={`/img/aetheris/${screenshot.file}`} alt={screenshot.title} loading="lazy" />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="band band--tint section" id="features">
      <div class="container">
        <div class="section-head">
          <h2>{page.featuresTitle}</h2>
          <p>{page.featuresSubtitle}</p>
        </div>

        <div class="product-card-grid">
          {page.features.map((feature) => (
            <article class="card product-card">
              <span class="product-dot" aria-hidden="true"></span>
              <h3>{feature.name}</h3>
              <p>{feature.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="band band--accent section">
      <div class="container">
        <div class="section-head">
          <h2>{page.designTitle}</h2>
        </div>
        <div class="design-grid">
          {page.design.map((principle) => (
            <article class="design-item">
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </article>
          ))}
        </div>

        <p class="back-home">
          <a href={homeHref}>← {page.backHome}</a>
        </p>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<script>
  import { latestRelease, type Release } from '../scripts/latest-release';

  type Platform = 'linux' | 'mac' | 'windows';

  const button = document.querySelector<HTMLAnchorElement>('[data-aetheris-download]')!;
  const version = document.querySelector<HTMLElement>('[data-aetheris-version]')!;

  function currentPlatform(): Platform {
    const override = new URLSearchParams(location.search).get('platform')?.toLowerCase();
    if (override === 'linux' || override === 'mac' || override === 'windows') return override;

    const fingerprint =
      `${navigator.userAgentData?.platform ?? navigator.platform} ${navigator.userAgent}`.toLowerCase();
    if (fingerprint.includes('win')) return 'windows';
    if (fingerprint.includes('mac')) return 'mac';
    return 'linux';
  }

  async function currentArchitecture(): Promise<string> {
    const uaData = navigator.userAgentData;
    if (!uaData?.getHighEntropyValues) return '';
    try {
      const { architecture } = await uaData.getHighEntropyValues(['architecture']);
      return (architecture ?? '').toLowerCase();
    } catch {
      return '';
    }
  }

  function assetFor(assets: Release['assets'], platform: Platform, architecture: string) {
    const match = (pattern: RegExp) => assets.find((asset) => pattern.test(asset.name));
    if (platform === 'windows') {
      return match(/windows-x86_64-setup\.exe$/i) ?? match(/windows.*\.zip$/i);
    }
    if (platform === 'mac') {
      const arm = architecture.includes('arm') || architecture.includes('aarch64');
      return arm
        ? match(/macos-aarch64\.dmg$/i) ?? match(/macos-x86_64\.dmg$/i)
        : match(/macos-x86_64\.dmg$/i) ?? match(/macos-aarch64\.dmg$/i);
    }
    return match(/linux-x86_64\.flatpak$/i) ?? match(/x86_64\.AppImage$/i);
  }

  const platform = currentPlatform();
  const labels: Record<Platform, string> = {
    linux: button.dataset.downloadLinux!,
    mac: button.dataset.downloadMac!,
    windows: button.dataset.downloadWindows!,
  };
  button.textContent = labels[platform];

  async function applyLatestRelease() {
    const [release, architecture] = await Promise.all([
      latestRelease(button.dataset.repo!),
      currentArchitecture(),
    ]);
    if (!release) return;

    version.textContent = release.tag_name;
    const asset = assetFor(release.assets, platform, architecture);
    if (asset) button.href = asset.browser_download_url;
  }

  applyLatestRelease();
</script>
