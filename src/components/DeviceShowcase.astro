---
import type { Lang } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---

<div class="stage" role="img" aria-label={t.hero.deviceNote}>
  <div class="device tv">
    <div class="screen aurora-screen">
      <span class="edition mono">Cast</span>
      <span class="pill">{t.hero.soon}</span>
    </div>
    <div class="tv-stand"></div>
  </div>

  <div class="device tablet">
    <div class="screen aurora-screen">
      <span class="edition mono">Tablet</span>
      <span class="pill">{t.hero.soon}</span>
    </div>
  </div>

  <div class="device laptop">
    <div class="laptop-lid">
      <div class="screen ws-screen">
        <div class="ws-wall" aria-hidden="true"></div>
        <header class="ws-panel">
          <svg viewBox="-0.3 -0.3 567.4 567.4" class="ws-logo"><use href="/spotlight-icons.svg#brand" /></svg>
          <span class="ws-pill"><i class="ws-ws-bar"></i><i></i><i></i><i></i><i></i></span>
          <span class="ws-clock" data-ws-clock>Aug 4&ensp;8:32 PM</span>
          <span class="ws-status">
            <svg viewBox="0 0 16 16" fill="currentColor"><use href="/spotlight-icons.svg#gi-clipboard" /></svg>
            <svg viewBox="0 0 16 16" fill="currentColor"><use href="/spotlight-icons.svg#gi-mic" /></svg>
            <svg viewBox="0 0 16 16" fill="currentColor"><use href="/spotlight-icons.svg#gi-volume" /></svg>
          </span>
        </header>
        <div class="ws-dock">
          <img src="/img/demos/firefox.png" alt="" />
          <img src="/img/demos/files.svg" alt="" />
          <img src="/img/demos/software.svg" alt="" />
          <img src="/img/demos/thunderbird.png" alt="" />
          <img src="/img/demos/calendar.svg" alt="" />
          <span class="ws-dock-sep"></span>
          <img src="/img/demos/removable.svg" alt="" />
          <img src="/img/demos/trash.svg" alt="" />
          <svg viewBox="0 0 16 16" class="ws-grid" fill="#f4f4f4"><use href="/spotlight-icons.svg#gi-grid" /></svg>
        </div>
      </div>
    </div>
    <div class="laptop-base"></div>
  </div>

  <div class="device phone">
    <div class="screen aurora-screen">
      <span class="notch"></span>
      <span class="edition mono">Mobile</span>
      <span class="pill">{t.hero.soon}</span>
    </div>
  </div>

  <div class="device deck">
    <div class="grip grip-l">
      <span class="stick"></span>
      <span class="dpad"></span>
    </div>
    <div class="screen aurora-screen">
      <span class="edition mono">Play</span>
      <span class="pill">{t.hero.soon}</span>
    </div>
    <div class="grip grip-r">
      <span class="stick"></span>
      <span class="buttons"><i></i><i></i><i></i><i></i></span>
    </div>
  </div>

</div>

<script>
  const clockEl = document.querySelector('[data-ws-clock]');
  if (clockEl) {
    const locale = document.documentElement.lang === 'pt-BR' ? 'pt-BR' : 'en-US';
    const tick = () => {
      const now = new Date();
      const date = new Intl.DateTimeFormat(locale, { month: 'short', day: 'numeric' }).format(now);
      const time = new Intl.DateTimeFormat(locale, {
        hour: 'numeric',
        minute: '2-digit',
        hour12: locale === 'en-US',
      }).format(now);
      clockEl.textContent = `${date} ${time}`;
    };
    tick();
    setInterval(tick, 30_000);
  }
</script>

<style>
  .stage {
    position: relative;
    width: 100%;
    max-width: 64rem;
    aspect-ratio: 16 / 9.5;
    margin-top: 0;
    margin-inline: 0;
  }

  .device {
    position: absolute;
    opacity: 0;
    animation: device-in 1s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }

  @keyframes device-in {
    from { opacity: 0; transform: translateY(36px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .screen {
    border-radius: inherit;
    overflow: hidden;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45em;
    position: relative;
  }

  .aurora-screen {
    background:
      linear-gradient(180deg, rgba(53, 132, 228, 0.12), transparent 34%),
      var(--screen-night);
  }

  .edition {
    font-size: clamp(0.55rem, 1.4cqw, 1.05rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .pill {
    font-family: var(--font-mono);
    font-size: clamp(0.45rem, 1cqw, 0.7rem);
    padding: 0.25em 0.9em;
    border-radius: 999px;
    border: 1px solid var(--border-color);
    color: var(--ink-dim);
    background: var(--surface-2);
    white-space: nowrap;
  }

  .tv {
    left: 50%;
    top: 0;
    width: 56%;
    margin-left: -28%; /* keep centered: the entry animation owns `transform` */
    z-index: 1;
    animation-delay: 0.05s;
    container-type: inline-size;
  }

  .tv .screen {
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    border: 3px solid var(--device-bezel);
  }

  .tv-stand {
    width: 26%;
    height: 0.9vw;
    margin: 0 auto;
    background: var(--device-bezel);
    border-radius: 0 0 8px 8px;
  }

  .laptop {
    left: 50%;
    bottom: 9%;
    width: 44%;
    margin-left: -22%;
    z-index: 3;
    animation-delay: 0.25s;
    container-type: inline-size;
  }

  .laptop-lid {
    border: 3px solid var(--device-bezel);
    border-bottom-width: 0;
    border-radius: 12px 12px 0 0;
    background: var(--device-body);
    padding: 1.2% 1.2% 0;
  }

  .laptop .screen {
    aspect-ratio: 827 / 469;
    border-radius: 8px 8px 0 0;
  }

  .ws-screen {
    display: block;
    background: #141318;
    color: #f4f4f4;
  }

  .ws-wall {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(90cqw 55cqw at 12% -10%, rgba(53, 132, 228, 0.4), transparent 62%),
      radial-gradient(70cqw 50cqw at 95% 108%, rgba(145, 65, 172, 0.42), transparent 60%),
      radial-gradient(45cqw 32cqw at 78% 8%, rgba(46, 194, 126, 0.2), transparent 65%),
      linear-gradient(158deg, #1d1b24, #141318 55%, #100f14);
  }

  .ws-panel {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 6.2cqw;
    display: flex;
    align-items: center;
    gap: 1.4cqw;
    padding-inline: 2.2cqw;
    background: #333336;
  }

  .ws-logo {
    width: 2.4cqw;
    height: 2.4cqw;
    color: #f4f4f4;
  }

  .ws-pill {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.7cqw;
    padding: 0.7cqw 1.1cqw;
    border-radius: 999px;
    background: #4a4a4e;
  }

  .ws-pill i {
    width: 0.6cqw;
    height: 0.6cqw;
    border-radius: 50%;
    background: #c7c7c7;
  }

  .ws-ws-bar {
    position: absolute;
    left: 1.1cqw;
    width: 1.8cqw !important;
    border-radius: 999px !important;
    background: #f4f4f4 !important;
    animation: ws-switch 8s ease-in-out infinite;
  }

  @keyframes ws-switch {
    0%, 22% { transform: translateX(0); }
    30%, 52% { transform: translateX(1.3cqw); }
    60%, 82% { transform: translateX(2.6cqw); }
    90%, 100% { transform: translateX(0); }
  }

  .ws-clock {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 1.8cqw;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .ws-status {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 1.5cqw;
    color: #e8e8ea;
  }

  .ws-status svg {
    width: 2.3cqw;
    height: 2.3cqw;
    display: block;
  }

  .ws-dock {
    position: absolute;
    left: 50%;
    bottom: 2.4cqw;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 1.5cqw;
    padding: 1.4cqw 1.9cqw;
    background: #333336;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 2.6cqw;
    box-shadow: 0 1cqw 3cqw rgba(0, 0, 0, 0.5);
  }

  .ws-dock img {
    width: 6cqw;
    height: auto;
    display: block;
  }

  .ws-dock-sep {
    width: 1px;
    height: 5.4cqw;
    background: rgba(255, 255, 255, 0.16);
  }

  .ws-grid {
    width: 5.2cqw;
    height: 5.2cqw;
  }

  @media (prefers-reduced-motion: reduce) {
    .ws-ws-bar {
      animation: none;
    }
  }

  .laptop-base {
    height: 1.1vw;
    background: var(--device-bezel);
    border-radius: 0 0 14px 14px;
    width: 108%;
    margin-left: -4%;
  }

  .tablet {
    left: 15%;
    bottom: 4%;
    width: 15%;
    z-index: 4;
    rotate: -4deg;
    animation-delay: 0.45s;
    container-type: inline-size;
  }

  .tablet .screen {
    aspect-ratio: 3 / 4;
    border-radius: 14px;
    border: 3px solid var(--device-bezel);
  }

  .phone {
    right: 34%;
    bottom: 3%;
    width: 7.5%;
    z-index: 5;
    rotate: 4deg;
    animation-delay: 0.6s;
    container-type: inline-size;
  }

  .phone .screen {
    aspect-ratio: 9 / 19;
    border-radius: 16px;
    border: 3px solid var(--device-bezel);
  }

  .notch {
    position: absolute;
    top: 4%;
    left: 50%;
    transform: translateX(-50%);
    width: 34%;
    height: 2.5%;
    border-radius: 999px;
    background: var(--device-bezel);
  }

  .deck {
    right: 9%;
    bottom: 10%;
    width: 23%;
    z-index: 3;
    display: flex;
    align-items: stretch;
    animation-delay: 0.75s;
    container-type: inline-size;
  }

  .deck .screen {
    aspect-ratio: 16 / 10;
    border-radius: 6px;
    border: 3px solid var(--device-bezel);
    flex: 1;
  }

  .grip {
    width: 17%;
    background: var(--device-body);
    position: relative;
  }

  .grip-l {
    border-radius: 45% 6px 6px 45% / 30% 6px 6px 30%;
    margin-right: -2px;
  }

  .grip-r {
    border-radius: 6px 45% 45% 6px / 6px 30% 30% 6px;
    margin-left: -2px;
  }

  .stick {
    position: absolute;
    top: 18%;
    left: 50%;
    transform: translateX(-50%);
    width: 46%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--device-bezel);
    border: 1px solid var(--border-color);
  }

  .dpad,
  .buttons {
    position: absolute;
    bottom: 16%;
    left: 50%;
    transform: translateX(-50%);
    width: 48%;
    aspect-ratio: 1;
  }

  .dpad {
    background:
      linear-gradient(var(--device-bezel), var(--device-bezel)) 50% 0 / 34% 100% no-repeat,
      linear-gradient(var(--device-bezel), var(--device-bezel)) 0 50% / 100% 34% no-repeat;
    border-radius: 4px;
  }

  .buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18%;
    rotate: 45deg;
  }

  .buttons i {
    border-radius: 50%;
    background: var(--device-bezel);
  }

  @media (max-width: 640px) {
    .stage {
      aspect-ratio: 16 / 14;
    }

    .tv {
      width: 72%;
      margin-left: -36%;
    }

    .laptop {
      width: 56%;
      margin-left: -28%;
      bottom: 14%;
    }

    .tablet {
      left: 8%;
      bottom: 2%;
      width: 18%;
    }

    .phone {
      right: 36%;
      bottom: 0;
      width: 11%;
    }

    .deck {
      right: 5%;
      width: 28%;
      bottom: 4%;
    }
  }
</style>
