---
interface Props {
  demo: 'dock' | 'clipboard' | 'mixer' | 'clock' | 'tray';
  title: string;
}

const { demo, title } = Astro.props;
// volume: null means the slider is animated by CSS (.sd-slider--game).
const mixerStreams: { app: string; level: number; volume: number | null }[] = [
  { app: 'firefox', level: 68, volume: 82 },
  { app: 'firefox', level: 84, volume: null },
  { app: 'kdenlive', level: 46, volume: 88 },
];

const clipboardRows = [
  { modifier: 'sd-clip-row--new', text: 'sudo dnf upgrade --refresh', pinned: false },
  { modifier: 'sd-clip-row--k1', text: 'https://luminusos.org/aurora', pinned: true },
  { modifier: 'sd-clip-row--k2', text: 'maria.souza@example.com', pinned: false },
  { modifier: 'sd-clip-row--k3', text: '192.0.2.10', pinned: false },
];

const fileRows = [
  { name: 52, size: 14 },
  { name: 68, size: 11 },
  { name: 41, size: 16 },
  { name: 59, size: 12 },
];
---

<div class={`sd sd-${demo}`} role="img" aria-label={title}>
  <div class="sd-wallpaper" aria-hidden="true"></div>

  <header class="sd-panel">
    <span class="sd-panel-left">
      <svg viewBox="-0.3 -0.3 567.4 567.4" class="sd-ic"><use href="/spotlight-icons.svg#brand" /></svg>
      <span class="sd-ws-pill"><i class="sd-ws-dot sd-ws-dot--bar"></i><i class="sd-ws-dot"></i><i class="sd-ws-dot"></i><i class="sd-ws-dot"></i></span>
    </span>
    {demo === 'clock' ? (
      <span class="sd-panel-clock sd-panel-clock--rich">
        <span class="sd-clock-weather">
          <svg viewBox="0 0 16 16" class="sd-clock-sun" fill="currentColor"><use href="/spotlight-icons.svg#gi-sun" /></svg>
          21°
        </span>
        <span>Aug 4&ensp;8:32 PM</span>
        <span class="sd-clock-meet">
          <i></i>Standup 10:00
        </span>
      </span>
    ) : (
      <span class="sd-panel-clock">Aug 4&ensp;8:32 PM</span>
    )}
    <span class="sd-panel-right">
      {demo === 'tray' && (
        <span class="sd-tray-clip">
          <span class="sd-tI sd-tC">
            <i class="sd-tray-chev">
              <svg viewBox="0 0 16 16" class="sd-tray-chev-ic" fill="currentColor"><use href="/spotlight-icons.svg#gi-prev" /></svg>
            </i>
          </span>
          <span class="sd-tI sd-t1">
            <i class="sd-tray-mini"><img src="/img/demos/steam.png" alt="" /></i>
          </span>
          <span class="sd-tI">
            <i class="sd-tray-mini"><img src="/img/demos/safeeyes.png" alt="" /></i>
          </span>
          <span class="sd-tI sd-t3">
            <i class="sd-tray-mini"><img src="/img/demos/telegram.png" alt="" /></i>
          </span>
          <span class="sd-tI sd-t4">
            <i class="sd-tray-mini"><img src="/img/demos/karere.png" alt="" /></i>
          </span>
          <span class="sd-tI sd-t5">
            <i class="sd-tray-mini"><img src="/img/demos/superproductivity.png" alt="" /></i>
          </span>
          <span class="sd-tI sd-tD">
            <i class="sd-tray-mini"><img src="/img/demos/telegram.png" alt="" /></i>
          </span>
        </span>
      )}
      <span class={demo === 'clipboard' ? 'sd-panel-clip' : ''}>
        <svg viewBox="0 0 16 16" class="sd-ic" fill="currentColor"><use href="/spotlight-icons.svg#gi-clipboard" /></svg>
      </span>
      <svg viewBox="0 0 16 16" class="sd-ic" fill="currentColor"><use href="/spotlight-icons.svg#gi-mic" /></svg>
      {demo !== 'tray' && (
        <>
          <svg viewBox="0 0 16 16" class="sd-ic" fill="currentColor"><use href="/spotlight-icons.svg#gi-a11y" /></svg>
          <svg viewBox="0 0 16 16" class="sd-ic" fill="currentColor"><use href="/spotlight-icons.svg#gi-eye" /></svg>
          <svg viewBox="0 0 16 16" class="sd-ic" fill="currentColor"><use href="/spotlight-icons.svg#gi-bell-off" /></svg>
        </>
      )}
      <svg viewBox="0 0 16 16" class="sd-ic" fill="currentColor"><use href="/spotlight-icons.svg#gi-volume" /></svg>
      {demo !== 'tray' && (
        <svg viewBox="0 0 16 16" class="sd-ic" fill="currentColor"><use href="/spotlight-icons.svg#gi-headphones" /></svg>
      )}
    </span>
  </header>

  {demo === 'dock' && (
    <>
      <div class="sd-dock-window">
        <div class="sd-win-titlebar">
          <span>Files</span>
          <em class="sd-win-close">
            <svg viewBox="0 0 16 16" fill="currentColor"><use href="/spotlight-icons.svg#gi-close" /></svg>
          </em>
        </div>
        <div class="sd-win-body">
          {fileRows.map((row) => (
            <div class="sd-win-row">
              <svg viewBox="0 0 16 16" class="sd-win-folder" fill="#62a0ea"><use href="/spotlight-icons.svg#gi-folder" /></svg>
              <b style={`width: ${row.name}%`}></b><u style={`width: ${row.size}%`}></u>
            </div>
          ))}
        </div>
      </div>

      <div class="sd-dock-cursor">
        <svg viewBox="0 0 16 16"><path d="M3 1.5 13 8l-4.4.8L6 13z" fill="#fff" stroke="#1c1c1e" stroke-width="1"/></svg>
      </div>

      <div class="sd-dock-bar">
        <i class="sd-dock-icon"><img src="/img/demos/firefox.png" alt="" /></i>
        <i class="sd-dock-icon"><img src="/img/demos/files.svg" alt="" /></i>
        <i class="sd-dock-icon"><img src="/img/demos/software.svg" alt="" /></i>
        <i class="sd-dock-icon"><img src="/img/demos/thunderbird.png" alt="" /></i>
        <i class="sd-dock-icon"><img src="/img/demos/calendar.svg" alt="" /></i>
        <span class="sd-dock-sep"></span>
        <i class="sd-dock-icon"><img src="/img/demos/removable.svg" alt="" /></i>
        <i class="sd-dock-icon"><img src="/img/demos/trash.svg" alt="" /></i>
        <i class="sd-dock-icon">
          <svg viewBox="-2 -2 20 20" fill="#f4f4f4"><use href="/spotlight-icons.svg#gi-grid" /></svg>
        </i>
      </div>
    </>
  )}

  {demo === 'clipboard' && (
    <div class="sd-menu sd-clip-menu">
      <div class="sd-clip-search">
        <svg viewBox="0 0 16 16" fill="currentColor"><use href="/spotlight-icons.svg#gi-search" /></svg>
        <span class="sd-clip-typed">lumi</span><span class="sd-clip-caret"></span>
      </div>
      <div class="sd-clip-list">
        {clipboardRows.map((row) => (
          <div class={`sd-clip-row ${row.modifier}`}>
            <span class="sd-clip-txt">{row.text}</span>
            <span class="sd-clip-actions">
              <i class={row.pinned ? 'sd-clip-act sd-clip-act--pin' : 'sd-clip-act'}><svg viewBox="0 0 16 16" fill="currentColor"><use href="/spotlight-icons.svg#gi-pin" /></svg></i>
              <i class="sd-clip-act"><svg viewBox="0 0 16 16" fill="currentColor"><use href="/spotlight-icons.svg#gi-trash" /></svg></i>
              <i class="sd-clip-act"><svg viewBox="0 0 16 16" fill="currentColor"><use href="/spotlight-icons.svg#gi-more" /></svg></i>
            </span>
          </div>
        ))}
        <div class="sd-clip-row">
          <span class="sd-clip-txt">Rua Exemplo, 123 - Cidade</span>
        </div>
      </div>
      <i class="sd-scrollbar" style="--sb: 34%"></i>
    </div>
  )}

  {demo === 'mixer' && (
    <div class="sd-menu sd-mix-menu">
      <div class="sd-mix-out">
        <svg viewBox="0 0 16 16" class="sd-mix-ic" fill="currentColor"><use href="/spotlight-icons.svg#gi-headphones" /></svg>
        <span class="sd-slider"><i class="sd-slider-fill" style="width: 62%"></i><i class="sd-slider-knob" style="left: 62%"></i></span>
        <svg viewBox="0 0 16 16" class="sd-mix-chev" fill="currentColor"><use href="/spotlight-icons.svg#gi-next" /></svg>
      </div>

      <div class="sd-mix-page">
        <div class="sd-mix-head">
          <i class="sd-mix-head-ic">
            <svg viewBox="0 0 16 16" fill="currentColor"><use href="/spotlight-icons.svg#gi-volume" /></svg>
          </i>
          <span>Volume Mixer</span>
        </div>

        <div class="sd-mix-streams">
          {mixerStreams.map((stream) => (
            <div class="sd-mix-stream">
              <div class="sd-mix-name">
                <i class="sd-mix-app"><img src={`/img/demos/${stream.app}.png`} alt="" /></i>
                <i class="sd-mix-bar" style={`width: ${stream.level}%`}></i>
              </div>
              <div class="sd-mix-sliderow">
                <svg viewBox="0 0 16 16" class="sd-mix-ic" fill="currentColor"><use href="/spotlight-icons.svg#gi-volume" /></svg>
                {stream.volume === null ? (
                  <span class="sd-slider sd-slider--game"><i class="sd-slider-fill"></i><i class="sd-slider-knob"></i></span>
                ) : (
                  <span class="sd-slider"><i class="sd-slider-fill" style={`width: ${stream.volume}%`}></i><i class="sd-slider-knob" style={`left: ${stream.volume}%`}></i></span>
                )}
              </div>
            </div>
          ))}
        </div>
        <i class="sd-scrollbar" style="--sb: 22%"></i>

        <div class="sd-mix-footer">Sound Settings</div>
      </div>
    </div>
  )}

  {demo === 'clock' && (
    <div class="sd-banner">
      <div class="sd-banner-head">
        <svg viewBox="0 0 16 16" class="sd-banner-head-ic" fill="currentColor"><use href="/spotlight-icons.svg#gi-calendar" /></svg>
        <i class="sd-banner-bar" style="width: 15%"></i>
        <i class="sd-banner-bar sd-banner-bar--dim" style="width: 8%"></i>
        <em class="sd-banner-close">
          <svg viewBox="0 0 16 16" fill="currentColor"><use href="/spotlight-icons.svg#gi-close" /></svg>
        </em>
      </div>
      <div class="sd-banner-main">
        <i class="sd-banner-ic">
          <svg viewBox="0 0 16 16" fill="#fff"><use href="/spotlight-icons.svg#gi-calendar" /></svg>
        </i>
        <span class="sd-banner-txt">
          <b>Standup starting soon</b>
          <i class="sd-banner-bar" style="width: 78%"></i>
          <i class="sd-banner-bar sd-banner-bar--dim" style="width: 52%"></i>
        </span>
      </div>
      <div class="sd-banner-actions">
        <em class="sd-btn">Join</em>
        <em class="sd-btn sd-btn--snooze">Snooze</em>
        <em class="sd-btn">Dismiss</em>
      </div>
    </div>
  )}
</div>

<style>
  .sd {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 16 / 10;
    width: min(100%, 760px);
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: #141318;
    color: #f4f4f4;
    font-size: 1.7cqw;
    user-select: none;
  }

  .sd-wallpaper {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(90cqw 55cqw at 12% -10%, rgba(53, 132, 228, 0.4), transparent 62%),
      radial-gradient(70cqw 50cqw at 95% 108%, rgba(145, 65, 172, 0.42), transparent 60%),
      radial-gradient(45cqw 32cqw at 78% 8%, rgba(46, 194, 126, 0.2), transparent 65%),
      linear-gradient(158deg, #1d1b24, #141318 55%, #100f14);
  }

  .sd-panel {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 7.4cqw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 2.2cqw;
    background: #333336;
    font-size: 1.8cqw;
    font-weight: 600;
    letter-spacing: 0.01em;
    z-index: 3;
  }

  .sd-panel-left {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
  }


  .sd-ws-pill {
    display: flex;
    align-items: center;
    gap: 0.7cqw;
    padding: 0.8cqw 1.2cqw;
    border-radius: 999px;
    background: #4a4a4e;
  }

  .sd-ws-dot {
    width: 0.65cqw;
    height: 0.65cqw;
    border-radius: 50%;
    background: #c7c7c7;
  }

  .sd-ws-dot--bar {
    width: 2cqw;
    border-radius: 999px;
    background: #f4f4f4;
  }

  .sd-panel-clock {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .sd-panel-right {
    display: flex;
    align-items: center;
    gap: 1.7cqw;
    color: #e8e8ea;
  }

  .sd-ic {
    width: 2.5cqw;
    height: 2.5cqw;
    display: block;
  }

  .sd-panel .sd-ic { color: #f4f4f4; }

  .sd-panel-clip {
    display: grid;
    place-items: center;
    padding: 0.7cqw;
    margin: -0.7cqw;
    border-radius: 1cqw;
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
  }

  .sd-menu {
    position: absolute;
    top: 9.4cqw;
    right: 4cqw;
    width: 60cqw;
    background: #242427;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 2.6cqw;
    box-shadow: 0 1.6cqw 4.5cqw rgba(0, 0, 0, 0.55);
    padding: 2.2cqw;
    z-index: 4;
  }

  .sd-scrollbar {
    position: absolute;
    top: 18%;
    bottom: 18%;
    right: 1cqw;
    width: 0.7cqw;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
  }

  .sd-scrollbar::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--sb, 30%);
    border-radius: inherit;
    background: rgba(255, 255, 255, 0.3);
  }

  .sd-dock-window {
    position: absolute;
    left: 13%;
    top: 15%;
    width: 45%;
    height: 52%;
    background: #1e1e20;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 1.8cqw;
    overflow: hidden;
    box-shadow: 0 1.2cqw 3.5cqw rgba(0, 0, 0, 0.5);
    z-index: 2;
  }

  .sd-win-titlebar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 5.6cqw;
    background: #2d2d30;
    font-size: 1.6cqw;
    font-weight: 700;
    color: #f4f4f4;
  }

  .sd-win-close {
    position: absolute;
    right: 1.2cqw;
    width: 3.2cqw;
    height: 3.2cqw;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #f4f4f4;
    background: rgba(255, 255, 255, 0.07);
  }

  .sd-win-close svg { width: 55%; height: 55%; }

  .sd-win-body {
    display: grid;
    gap: 0.9cqw;
    padding: 1.8cqw 2cqw;
  }

  .sd-win-row {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
    padding: 0.9cqw 1.2cqw;
    border-radius: 1.2cqw;
  }

  .sd-win-row:first-child { background: rgba(98, 160, 234, 0.16); }

  .sd-win-folder {
    width: 2.6cqw;
    height: 2.6cqw;
    flex: none;
  }

  .sd-win-row b,
  .sd-win-row u {
    display: block;
    height: 1.3cqw;
    border-radius: 999px;
    background: #3a3a40;
  }

  .sd-win-row u {
    margin-left: auto;
    background: #2e2e33;
    text-decoration: none;
  }

  .sd-dock-bar {
    position: absolute;
    left: 50%;
    bottom: 2cqw;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 1.3cqw;
    padding: 1.3cqw 1.7cqw;
    background: #333336;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 2.4cqw;
    box-shadow: 0 1cqw 3cqw rgba(0, 0, 0, 0.5);
    z-index: 3;
  }

  .sd-dock-icon {
    width: 5.4cqw;
    height: 5.4cqw;
    display: grid;
    place-items: center;
  }

  .sd-dock-icon svg { width: 88%; height: 88%; }

  .sd-dock-icon img {
    width: 100%;
    height: auto;
    display: block;
  }

  .sd-dock-sep {
    width: 1px;
    align-self: stretch;
    margin-block: 0.6cqw;
    background: rgba(255, 255, 255, 0.16);
  }

  .sd-dock-cursor {
    position: absolute;
    left: 50%;
    top: 62%;
    width: 3.2cqw;
    height: 3.2cqw;
    margin-left: -1.6cqw;
    opacity: 0;
    z-index: 5;
    filter: drop-shadow(0 0.3cqw 0.6cqw rgba(0, 0, 0, 0.6));
  }

  .sd-dock-cursor svg { width: 100%; height: 100%; }

  @keyframes sd-dock-window-grow {
    0%, 18% { height: 52%; }
    34%, 72% { height: 74%; }
    88%, 100% { height: 52%; }
  }

  @keyframes sd-dock-hide {
    0%, 30% { transform: translateX(-50%) translateY(0); }
    38%, 58% { transform: translateX(-50%) translateY(160%); }
    68%, 100% { transform: translateX(-50%) translateY(0); }
  }

  @keyframes sd-dock-peek {
    0%, 44% { opacity: 0; top: 62%; }
    50% { opacity: 1; top: 62%; }
    58% { opacity: 1; top: 88%; }
    64%, 100% { opacity: 0; top: 88%; }
  }

  .sd-clip-search {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
    background: #3a3a3e;
    border-radius: 999px;
    padding: 1.3cqw 1.9cqw;
    color: #9a9a9e;
    font-size: 1.75cqw;
  }

  .sd-clip-search svg {
    width: 2.4cqw;
    height: 2.4cqw;
    flex: none;
  }

  .sd-clip-typed {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    max-width: 4.4ch;
    color: #f4f4f4;
  }

  .sd-clip-caret {
    width: 1px;
    height: 2.2cqw;
    background: #f4f4f4;
  }

  .sd-clip-list {
    display: grid;
    gap: 1cqw;
    margin-top: 1.8cqw;
    margin-right: 1.6cqw;
  }

  .sd-clip-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.6cqw;
    min-height: 6.4cqw;
    padding: 1.2cqw 1.6cqw;
    border-radius: 1.6cqw;
    background: #303033;
    border: 1px solid transparent;
  }

  .sd-clip-row--new {
    overflow: hidden;
    max-height: 9cqw;
  }

  .sd-clip-txt {
    font-size: 1.7cqw;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sd-clip-actions {
    display: flex;
    gap: 1cqw;
    margin-left: auto;
    flex: none;
    opacity: 0;
  }

  .sd-clip-act {
    width: 3.6cqw;
    height: 3.6cqw;
    border-radius: 50%;
    background: #4a4a4e;
    display: grid;
    place-items: center;
    color: #e8e8ea;
  }

  .sd-clip-act svg { width: 58%; height: 58%; }

  .sd-clip-act--pin {
    background: #3584e4;
    color: #fff;
  }

  @keyframes sd-clip-menu-loop {
    0%, 6% { opacity: 0; transform: translateY(-1.6cqw) scale(0.98); }
    12%, 90% { opacity: 1; transform: none; }
    95%, 100% { opacity: 0; transform: translateY(-1.6cqw) scale(0.98); }
  }

  @keyframes sd-clip-typing {
    0%, 14% { max-width: 0; }
    30%, 88% { max-width: 4.4ch; }
    94%, 100% { max-width: 0; }
  }

  @keyframes sd-clip-caret-blink {
    0%, 45%, 100% { opacity: 1; }
    50%, 95% { opacity: 0; }
  }

  @keyframes sd-clip-hl-1 {
    0%, 34% { background: #303033; border-color: transparent; }
    40%, 48% { background: #3d3d42; border-color: rgba(98, 160, 234, 0.6); }
    54%, 100% { background: #303033; border-color: transparent; }
  }

  @keyframes sd-clip-hl-2 {
    0%, 48% { background: #303033; border-color: transparent; }
    54%, 62% { background: #3d3d42; border-color: rgba(98, 160, 234, 0.6); }
    68%, 100% { background: #303033; border-color: transparent; }
  }

  @keyframes sd-clip-hl-3 {
    0%, 62% { background: #303033; border-color: transparent; }
    68%, 80% { background: #3d3d42; border-color: rgba(98, 160, 234, 0.6); }
    86%, 100% { background: #303033; border-color: transparent; }
  }

  @keyframes sd-clip-act-1 {
    0%, 38% { opacity: 0; }
    42%, 50% { opacity: 1; }
    54%, 100% { opacity: 0; }
  }

  @keyframes sd-clip-act-2 {
    0%, 52% { opacity: 0; }
    56%, 64% { opacity: 1; }
    68%, 100% { opacity: 0; }
  }

  @keyframes sd-clip-act-3 {
    0%, 66% { opacity: 0; }
    70%, 82% { opacity: 1; }
    86%, 100% { opacity: 0; }
  }

  @keyframes sd-clip-new {
    0%, 70% { opacity: 0; transform: translateY(-1.2cqw); max-height: 0; min-height: 0; padding-block: 0; border-width: 0; }
    78%, 90% { opacity: 1; transform: none; max-height: 9cqw; min-height: 6.4cqw; padding-block: 1.2cqw; border-width: 1px; }
    95%, 100% { opacity: 0; transform: translateY(-1.2cqw); max-height: 0; min-height: 0; padding-block: 0; border-width: 0; }
  }

  .sd-mix-menu {
    width: 54cqw;
  }

  .sd-mix-out {
    display: flex;
    align-items: center;
    gap: 1.6cqw;
    padding: 0.2cqw 0.4cqw 1.4cqw;
  }

  .sd-mix-chev {
    width: 2.4cqw;
    height: 2.4cqw;
