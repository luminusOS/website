---
import '../styles/global.css';
import GoogleFonts from '../components/shared/GoogleFonts.astro';
import SocialMeta from '../components/shared/SocialMeta.astro';
import ThemeInit from '../components/shared/ThemeInit.astro';
import type { Lang } from '../i18n/translations';
import { langPrefix } from '../i18n/translations';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  ogImage?: string;
}

const { lang, title, description, path, ogImage = '/social-card.png' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(base + langPrefix(lang) + path, Astro.site);
const altEn = new URL(base + path, Astro.site);
const altPt = new URL(base + '/pt-br' + (path === '/' ? '' : path), Astro.site);
const assetOrigin = import.meta.env.DEV ? Astro.url.origin : Astro.site;
const socialImage = new URL(base + ogImage, assetOrigin);
---

<!doctype html>
<html lang={lang === 'pt-br' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <ThemeInit />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="pt-BR" href={altPt} />
    <SocialMeta
      title={title}
      description={description}
      url={canonical}
      image={socialImage}
      siteName="LuminusOS"
      locale={lang === 'pt-br' ? 'pt_BR' : 'en_US'}
    />
    <GoogleFonts />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
  </body>
</html>
